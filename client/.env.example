# Base URL of the API (no trailing slash). In development with the CRA proxy you can leave it empty.
REACT_APP_API_BASE=http://localhost:5000

# Optional: contact details shown on the site (defaults are in src/config/site.js)
REACT_APP_CONTACT_EMAIL=
REACT_APP_CONTACT_PHONE=
REACT_APP_WHATSAPP_NUMBER=
REACT_APP_UPI_ID=
