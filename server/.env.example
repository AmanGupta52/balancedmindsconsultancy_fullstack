# ---- Core ----
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/balanced-minds
# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Comma-separated frontend origins allowed by CORS
CLIENT_URLS=http://localhost:3000
# Public URL of the frontend (used to build video-call links)
FRONTEND_URL=http://localhost:3000

# ---- Email (OTP + admin approvals) ----
# Option A: Gmail (use an App Password)
EMAIL_USER=
EMAIL_PASS=
# Option B: any SMTP provider (overrides Gmail when SMTP_HOST is set)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=Balanced Minds Consultancy
# Where contact-form messages are e-mailed (they are always saved in the admin dashboard too)
CONTACT_INBOX=

# ---- First admin (used by `npm run seed:admin`) ----
ADMIN_NAME=Site Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Payments (optional: without these the UPI QR fallback is shown) ----
RAZORPAY_KEY_ID=
RAZORPAY_SECRET=
DEFAULT_SESSION_FEE=1000
BUSINESS_TZ_OFFSET=+05:30
# CODE:PERCENT_OFF pairs, e.g. WELCOME:20,FREE:100
COUPONS=

# ---- Video calls (ZegoCloud) ----
ZEGO_APP_ID=
ZEGO_SERVER_SECRET=

# ---- News ----
NEWS_API_KEY=
